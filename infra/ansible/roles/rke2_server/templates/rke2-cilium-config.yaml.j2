# Customises the Cilium chart that RKE2 ships with.
# RKE2's helm-controller watches /var/lib/rancher/rke2/server/manifests and
# applies any HelmChart / HelmChartConfig it finds there.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
{% if rke2_disable_kube_proxy %}
    # eBPF replaces kube-proxy. On RKE2 every node runs a local API proxy on
    # localhost:6443, so Cilium can always reach the API server.
    kubeProxyReplacement: true
    k8sServiceHost: "localhost"
    k8sServicePort: "6443"
{% endif %}
    operator:
      replicas: 1
      prometheus:
        enabled: true
    prometheus:
      enabled: true
    hubble:
      enabled: true
      relay:
        enabled: true
      ui:
        enabled: true
      metrics:
        enableOpenMetrics: true
        enabled:
          - dns
          - drop
          - tcp
          - flow
          - port-distribution
          - icmp
          - "httpV2:exemplars=true;labelsContext=source_ip,source_namespace,source_workload,destination_ip,destination_namespace,destination_workload,traffic_direction"
