# Single source of version pins for the shell scripts.
# Empty chart version = "latest in the repo at install time".
# Before each class delivery: run ./infra/scripts/show-latest-versions.sh,
# test the full build once, then run ./infra/scripts/pin-versions.sh to write
# the tested versions in here so every attendee gets an identical cluster.
# Last pinned from cluster https://10.99.3.143:6443 on 2026-11-14T18:49Z by infra/scripts/pin-versions.sh

# --- Kubernetes -------------------------------------------------------------
# RKE2 channel (v1.35 = SUSE extended support until Dec 2027) or an exact
# version such as v1.35.8+rke2r1. Match production where possible.
RKE2_CHANNEL="v1.35"
RKE2_VERSION="v1.35.10+rke2r1"

# --- Helm repositories -------------------------------------------------------
REPO_PROMETHEUS="https://prometheus-community.github.io/helm-charts"
REPO_GRAFANA_COMMUNITY="https://grafana-community.github.io/helm-charts"   # Loki moved here in Mar 2026
REPO_FLUENT="https://fluent.github.io/helm-charts"
REPO_HASHICORP="https://helm.releases.hashicorp.com"
REPO_STRIMZI="https://strimzi.io/charts/"
REPO_LOCAL_PATH="https://charts.containeroo.ch"                            # local-path-provisioner chart

# --- Chart versions (pin after testing) -------------------------------------
CHART_LOCAL_PATH="0.0.38"
CHART_KUBE_PROM_STACK="93.3.0"
CHART_LOKI="21.2.3"
CHART_FLUENT_BIT="0.58.3"
CHART_VAULT="0.34.1"
CHART_STRIMZI="1.3.1"

# --- Operators / images not shipped as Helm charts --------------------------
KEYCLOAK_VERSION="26.4.0"        # Keycloak Operator manifests + server image tag
POSTGRES_IMAGE="docker.io/library/postgres:17-alpine@sha256:d3244e8ce3f165ee3c93d9c4a4b1d0fe48b3a89e2287b717fdcbbde92d405065"
# Redis images are set in infra/charts/redis-lab/values.yaml and pinned to
# digests in infra/platform/redis/values-pinned.yaml (written by pin-versions.sh).

# --- Slide tooling (infra/scripts/build-slides.sh; run with npx) -------------
MARP_CLI_VERSION="4.1.2"
MERMAID_CLI_VERSION="11.4.2"

# --- Lab DNS -----------------------------------------------------------------
# Ingress hostnames use sslip.io so no DNS server is needed:
#   grafana.<INGRESS_IP>.sslip.io resolves to <INGRESS_IP>
# INGRESS_IP defaults to the first server node (set by deploy.sh from kubeconfig).
INGRESS_DOMAIN_SUFFIX="sslip.io"
